package ziyu

/* ============================================================================
 * 根包
 *
 * cjpm 源包扫描要求"所有父包（直到根包）也须为有效源包"，
 * 即 src/ 根必须直接包含至少一个 .cj 文件，否则 src/core、src/synth 等
 * 子包会被静默忽略（与 audio4cj 同样的原因，见其根包注释）。
 * ========================================================================== */

/// 库版本号，须与 cjpm.toml 的 version 保持一致
public let ZIYU_VERSION: String = "0.1.0"